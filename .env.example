# Copy to `.env` (or export in the shell). Never commit a filled copy.
# Hosted providers are optional. Missing keys mean those backends will refuse
# to run — they will not fall back to another paid API.

# Google Gemini (GeminiBackend). key_ref on the backend config: GEMINI_API_KEY
GEMINI_API_KEY=

# Anthropic Claude (AnthropicBackend). key_ref: ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# OpenAI Responses API (OpenAIBackend). key_ref: OPENAI_API_KEY
OPENAI_API_KEY=

# Optional instance-wide fallback if a backend has no key_ref.
# Leave empty. Prefer per-provider env vars above.
AI_DEFAULT_API_KEY=

# Public UI languages (comma-separated). Default includes Escript AI's set.
# French/German catalogs already exist upstream; add fr,de if you want them.
# ESC_LANGUAGES=en,ar,hi,pl,it,es,pt

# Local OpenAI-compatible server (Ollama / vLLM). No key required.
# Set the backend's `endpoint` in Django admin, e.g. http://127.0.0.1:11434/v1
# ESCRIPT_AI_LOCAL_ENDPOINT=http://127.0.0.1:11434/v1
